{
  "name": "maciweb-astro",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Web oficial de MACI (macimusic.es) migrada a Astro.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cms": "npm --prefix cms run develop",
    "cms:instalar": "npm --prefix cms install",
    "cms:exportar": "npm --prefix cms run exportar",
    "publicar": "node scripts/publicar.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "astro": "^7.3.5",
    "embla-carousel": "8.0.0",
    "embla-carousel-autoplay": "8.0.0"
  },
  "devDependencies": {
    "lucide-static": "0.418.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}

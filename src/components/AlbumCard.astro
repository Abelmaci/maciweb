---
// Tarjeta de disco del carrusel: portada que se desliza, vinilo giratorio con
// scratch (src/scripts/album-player.js) y overlay con la información.
// Los datos vienen de src/data/albums.json.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { TEXTOS, i18n } from '../data/textos';

export interface Album {
  id: string;
  title: string;
  uppercaseTitle?: boolean;
  highlightOnHover?: boolean;
  compactKicker?: boolean;
  cover: string;
  coverAlt: string;
  labelAlt?: string;
  audio: string;
  duration: number;
  badge: 'new' | 'playing' | null;
  kicker: { es: string; en: string };
  year: string | null;
  description: { es: string; en: string } | null;
  tags: string | null;
  countdown: { date: string; label: string } | null;
  spotify: string;
  spotifyLabel: string;
}

interface Props {
  album: Album;
}

const { album } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{jpg,jpeg,png,webp}', { eager: true });
const cover = images[`../assets/images/${album.cover}`]?.default;
if (!cover) {
  throw new Error(`[albums.json] No existe la portada "${album.cover}" en src/assets/images/ (disco "${album.title}").`);
}

const cardClass = [
  'album-card group relative aspect-square bg-surface cursor-pointer overflow-hidden shadow-2xl rounded-3xl',
  album.highlightOnHover && 'group-hover:bg-surface-container-highest transition-all duration-500',
].filter(Boolean).join(' ');

const kickerClass = album.compactKicker
  ? 'text-[0.6rem] md:text-xs text-white font-bold uppercase tracking-[0.05em] md:tracking-[0.3em] mt-2 break-words w-full'
  : 'text-xs text-white font-bold uppercase tracking-[0.3em] mt-2';

const cid = `cd${album.id}`;
// Textos fijos de las tarjetas (Strapi: «2 · Discografía (textos)»).
const t = TEXTOS.discografia;
---
<div class="embla__slide">
  <div class={cardClass} data-id={album.id} data-audio={album.audio} data-duration={album.duration}>
    <div
      class="vinyl-record absolute inset-0 flex items-center justify-center p-4 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-black/40">
      <div class="vinyl-disc relative w-[94%] h-[94%] rounded-full">
        <div class="vinyl-label absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[28%] h-[28%] rounded-full overflow-hidden border-[5px] border-[#141414] z-10">
          <Picture src={cover} alt={album.labelAlt ?? ''} formats={['avif', 'webp']} width={320} widths={[160, 320]}
            sizes="160px" loading="lazy" decoding="async"
            class="w-full h-full object-cover" referrerpolicy="no-referrer" />
        </div>
        <div class="vinyl-hole absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-[#0a0a0a] z-20"></div>
      </div>
    </div>

    <div
      class="album-cover absolute inset-0 transition-transform duration-700 cubic-bezier(0.4, 0, 0.2, 1) z-10 group-hover:-translate-x-full">
      <Picture src={cover} alt={album.coverAlt} formats={['avif', 'webp']} width={1200} widths={[480, 800, 1200]}
        sizes="(min-width: 1280px) 427px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
        loading="lazy" decoding="async"
        class="w-full h-full object-cover shadow-[15px_0_30px_rgba(0,0,0,0.6)]"
        referrerpolicy="no-referrer" />
    </div>

    <button
      class="mobile-touch-btn absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-40 w-16 h-16 rounded-full bg-white/10 backdrop-blur-xl border border-white/20 flex items-center justify-center lg:hidden opacity-80 shadow-2xl"
      aria-label={`Escuchar adelanto de ${album.title}`}>
      <Icon name="fingerprint" class="text-white w-8 h-8" />
    </button>

    <div
      class="info-overlay absolute inset-0 flex flex-col justify-end p-8 z-20 opacity-0 group-hover:opacity-100 translate-y-5 group-hover:translate-y-0 transition-all duration-500">
      {album.badge === 'new' && (
        <div class="flex items-center gap-3 mb-3">
          <span class="w-2 h-2 bg-primary rounded-full animate-ping"></span>
          <span {...i18n(t.etiquetaNuevo)}
            class="text-[0.65rem] font-bold text-white tracking-widest uppercase italic">{t.etiquetaNuevo.es}</span>
        </div>
      )}
      {album.badge === 'playing' && (
        <div class="flex items-center gap-3 mb-3">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          <span {...i18n(t.etiquetaReproduciendo)}
            class="text-[0.65rem] font-bold text-white tracking-widest uppercase">{t.etiquetaReproduciendo.es}</span>
        </div>
      )}
      <h3 class={`text-3xl font-black ${album.uppercaseTitle ? 'uppercase ' : ''}tracking-tighter text-white drop-shadow-2xl`}>{album.title}</h3>
      <p class={kickerClass}>
        <span data-i18n-es={album.kicker.es} data-i18n-en={album.kicker.en}>{album.kicker.es}</span>{album.year && ` // ${album.year}`}
      </p>
      {album.description && (
        <p data-i18n-es={album.description.es} data-i18n-en={album.description.en}
          class="text-[0.65rem] text-white/60 mt-2 uppercase tracking-widest">{album.description.es}</p>
      )}
      {album.tags && (
        <p class="text-[0.5rem] text-white/30 mt-2 tracking-[0.3em] uppercase font-light">{album.tags}</p>
      )}
      {album.countdown && (
        <div id={`card-countdown-${album.id}`} class="mt-3" data-countdown={album.countdown.date}>
          <span class="text-[0.5rem] font-bold tracking-[0.2em] uppercase text-primary/70 block mb-1"
            {...i18n(t.cuentaAtrasEtiqueta)}>{album.countdown.label}</span>
          <div class="flex gap-2">
            <div class="flex flex-col items-center"><span id={`${cid}-days`} data-countdown-part="days" class="text-base font-black tabular-nums text-white">--</span><span class="uppercase tracking-widest text-white/40" style="font-size:10px">DÍAS</span></div>
            <span class="text-base font-black text-primary/40 self-start mt-0.5">:</span>
            <div class="flex flex-col items-center"><span id={`${cid}-hours`} data-countdown-part="hours" class="text-base font-black tabular-nums text-white">--</span><span class="uppercase tracking-widest text-white/40" style="font-size:10px">HR</span></div>
            <span class="text-base font-black text-primary/40 self-start mt-0.5">:</span>
            <div class="flex flex-col items-center"><span id={`${cid}-mins`} data-countdown-part="mins" class="text-base font-black tabular-nums text-white">--</span><span class="uppercase tracking-widest text-white/40" style="font-size:10px">MIN</span></div>
            <span class="text-base font-black text-primary/40 self-start mt-0.5">:</span>
            <div class="flex flex-col items-center"><span id={`${cid}-secs`} data-countdown-part="secs" class="text-base font-black tabular-nums text-white">--</span><span class="uppercase tracking-widest text-white/40" style="font-size:10px">SEG</span></div>
          </div>
        </div>
      )}
      <a href={album.spotify}
        target="_blank" rel="noopener noreferrer" {...i18n(t.botonSpotify)}
        aria-label={album.spotifyLabel}
        class="inline-block bg-[#1DB954] text-white rounded-full px-4 py-2 text-[0.65rem] font-bold uppercase tracking-widest mt-4 hover:bg-[#1ed760] transition-colors">{t.botonSpotify.es}</a>
    </div>
  </div>
</div>

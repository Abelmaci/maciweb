---
// Apps MACI: tarjeta de EasyPrompt (la app vive en public/app/).
import { TEXTOS, i18n, lineas } from '../data/textos';

const t = TEXTOS.apps;
---
<section id="easyprompt" class="py-32 px-8 bg-surface-container-low relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center">
    <div class="reveal mb-16">
      <div class="text-[0.6rem] md:text-[0.7rem] text-primary font-bold uppercase tracking-[0.2em] md:tracking-[0.5em] mb-4"
        {...i18n(t.etiqueta)}>
        {t.etiqueta.es}</div>
      <h2 {...i18n(t.titulo)}
        class="text-3xl md:text-6xl font-black uppercase tracking-tighter mb-8">{t.titulo.es}</h2>
      <p {...i18n(t.intro)}
        class="text-white/60 text-xl font-light italic">{t.intro.es}</p>
    </div>

    <!-- EasyPrompt Card -->
    <div class="reveal">
      <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black/40 backdrop-blur-xl flex flex-col items-center text-center group hover:border-primary/40 transition-all duration-300" style="padding:2.5rem;gap:1.5rem">

        <!-- Logo -->
        <img src="/app/imagenes-easyprompt/MACi%20easyprompt.svg" alt={`${t.appNombre} logo`} width="1807" height="570" loading="lazy" decoding="async" style="width:250px;max-width:100%;height:auto">

        <!-- Content -->
        <div class="flex flex-col items-center gap-4 w-full">
          <div>
            <span class="text-[0.6rem] font-bold uppercase tracking-[0.3em] text-primary/80"
              {...i18n(t.appEtiqueta)}>
              {t.appEtiqueta.es}</span>
            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white mt-1">{t.appNombre}</h3>
          </div>
          <p {...i18n(t.appDescripcion)}
            class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">
            {t.appDescripcion.es}
          </p>
          <div class="flex flex-wrap gap-2 justify-center">
            {lineas(t.appCaracteristicas).map((c) => (
              <span class="text-[0.65rem] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-white/10 text-white/40">{c}</span>
            ))}
          </div>
          <a href={t.appEnlace}
            {...i18n(t.appBoton)}
            aria-label="Abrir MACI EasyPrompt, generador de prompts para Suno"
            class="px-8 py-4 bg-primary text-black font-bold uppercase tracking-widest text-sm hover:bg-white transition-all shadow-[0_0_15px_rgba(255,68,68,0.3)] hover:shadow-[0_0_25px_rgba(255,68,68,0.6)] rounded-full">{t.appBoton.es}</a>
        </div>
      </div>
    </div>

  </div>
</section>

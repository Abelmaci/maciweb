---
// Apps MACI: tarjeta de EasyPrompt (la app vive en public/app/).
---
<section id="easyprompt" class="py-32 px-8 bg-surface-container-low relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center">
    <div class="reveal mb-16">
      <div class="text-[0.6rem] md:text-[0.7rem] text-primary font-bold uppercase tracking-[0.2em] md:tracking-[0.5em] mb-4"
        data-i18n-es="HERRAMIENTAS AI" data-i18n-en="AI TOOLS">
        HERRAMIENTAS AI</div>
      <h2 data-i18n-es="APPS MACI" data-i18n-en="MACI APPS"
        class="text-3xl md:text-6xl font-black uppercase tracking-tighter mb-8">APPS MACI</h2>
      <p data-i18n-es="Herramientas que uso para crear música con inteligencia artificial."
        data-i18n-en="Tools I use to create music with artificial intelligence."
        class="text-white/60 text-xl font-light italic">Herramientas que uso para crear música con inteligencia artificial.</p>
    </div>

    <!-- EasyPrompt Card -->
    <div class="reveal">
      <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black/40 backdrop-blur-xl flex flex-col items-center text-center group hover:border-primary/40 transition-all duration-300" style="padding:2.5rem;gap:1.5rem">

        <!-- Logo -->
        <img src="/app/imagenes-easyprompt/MACi%20easyprompt.svg" alt="MACI EasyPrompt logo" width="1807" height="570" loading="lazy" decoding="async" style="width:250px;max-width:100%;height:auto">

        <!-- Content -->
        <div class="flex flex-col items-center gap-4 w-full">
          <div>
            <span class="text-[0.6rem] font-bold uppercase tracking-[0.3em] text-primary/80"
              data-i18n-es="Generador de prompts · Gratuito" data-i18n-en="Prompt generator · Free">
              Generador de prompts · Gratuito</span>
            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white mt-1">MACI EasyPrompt</h3>
          </div>
          <p data-i18n-es="Construye el prompt de estilo y el negativo optimizados para Suno en segundos. Elige género, instrumentos, voces, mood y producción — la app genera el texto listo para pegar."
            data-i18n-en="Build optimized style and negative prompts for Suno in seconds. Choose genre, instruments, voices, mood and production — the app generates the text ready to paste."
            class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">
            Construye el prompt de estilo y el negativo optimizados para Suno en segundos. Elige género, instrumentos, voces, mood y producción — la app genera el texto listo para pegar.
          </p>
          <div class="flex flex-wrap gap-2 justify-center">
            <span class="text-[0.65rem] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-white/10 text-white/40">Prompt de estilo</span>
            <span class="text-[0.65rem] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-white/10 text-white/40">Prompt negativo</span>
            <span class="text-[0.65rem] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-white/10 text-white/40">Editor de letra</span>
            <span class="text-[0.65rem] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-white/10 text-white/40">Versión cover</span>
          </div>
          <a href="/app/maci-easyprompt.html"
            data-i18n-es="PROBAR AHORA" data-i18n-en="TRY NOW"
            aria-label="Abrir MACI EasyPrompt, generador de prompts para Suno"
            class="px-8 py-4 bg-primary text-black font-bold uppercase tracking-widest text-sm hover:bg-white transition-all shadow-[0_0_15px_rgba(255,68,68,0.3)] hover:shadow-[0_0_25px_rgba(255,68,68,0.6)] rounded-full">PROBAR AHORA</a>
        </div>
      </div>
    </div>

  </div>
</section>

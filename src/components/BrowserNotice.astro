---
// Aviso para Safari (se muestra desde un script inline del layout).
// Texto editable en Strapi («0 · Ajustes generales» → Aviso para Safari).
import { TEXTOS, i18n } from '../data/textos';

const aviso = TEXTOS.ajustes.avisoNavegador;
---
<div id="browser-notice"
  style="display:none; position:fixed; top:0; left:0; right:0; z-index:9999; background:#FF4444; color:#fff; font-size:0.75rem; font-weight:700; padding:0.6rem 1rem; text-align:center; letter-spacing:0.02em;">
  <span {...i18n(aviso)}>{aviso.es}</span>
  <button type="button" id="browser-notice-close" aria-label="Cerrar aviso"
    style="background:none; border:none; color:#fff; font-weight:900; margin-left:0.75rem; cursor:pointer; font-size:0.9rem; line-height:1; vertical-align:middle;">&times;</button>
</div>
<script is:inline>
  (function () {
    var ua = navigator.userAgent;
    var isSafari = window.MACI_IS_SAFARI || /^((?!chrome|android|crios|fxios|edg|opr|opera).)*safari/i.test(ua);
    if (!isSafari) return;

    document.documentElement.classList.add('is-safari');

    try {
      if (localStorage.getItem('browserNoticeDismissed') === '1') return;
    } catch (e) {}

    var notice = document.getElementById('browser-notice');
    notice.style.display = 'block';
    document.getElementById('browser-notice-close').addEventListener('click', function () {
      notice.style.display = 'none';
      try {
        localStorage.setItem('browserNoticeDismissed', '1');
      } catch (e) {}
    });
  })();
</script>

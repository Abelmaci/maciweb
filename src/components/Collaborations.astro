---
// Colaboraciones: texto + tarjeta con borde LED animado.
import { TEXTOS, i18n } from '../data/textos';

const t = TEXTOS.colaboraciones;
---
<section id="colaboraciones" class="py-32 px-8 bg-background relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center">
    <div class="reveal mb-16">
      <div
        class="text-[0.6rem] md:text-[0.7rem] text-primary font-bold uppercase tracking-[0.2em] md:tracking-[0.5em] mb-4"
        {...i18n(t.etiqueta)}>
        {t.etiqueta.es}</div>
      <h2 {...i18n(t.titulo)}
        class="reveal text-3xl md:text-6xl font-black uppercase tracking-tighter mb-8">{t.titulo.es}</h2>
      <p {...i18n(t.intro)}
        class="text-white/60 text-xl font-light italic">{t.intro.es}</p>
    </div>

    <div class="reveal space-y-8 text-on-surface-variant max-w-2xl mx-auto text-lg leading-relaxed mb-16">
      {t.parrafos.map((p) => (
        <p {...i18n(p)} class={p.destacado ? 'font-bold text-white' : undefined}>{p.es}</p>
      ))}
    </div>

    <div class="reveal relative overflow-hidden rounded-2xl p-[2px] mt-16 group">
      <!-- LED Moving Border (Rediseñado para evitar cortes del navegador por exceso de tamaño) -->
      <div
        class="absolute inset-[-200%] bg-[conic-gradient(transparent,transparent_35%,#FF4444_50%,transparent_50%,transparent_85%,#FF4444_100%)] animate-[spin_4s_linear_infinite]">
      </div>

      <!-- Inner Content masking the gradient -->
      <div
        class="relative bg-black/95 backdrop-blur-xl p-12 rounded-[14px] w-full h-full z-10 flex flex-col items-center border border-white/5">
        <h3 {...i18n(t.tarjetaTitulo)}
          class="reveal text-2xl font-black uppercase tracking-tight mb-8 text-white">{t.tarjetaTitulo.es}</h3>
        <div class="flex flex-wrap justify-center gap-6">
          <a href={t.botonEnlace} target="_blank" rel="noopener noreferrer"
            {...i18n(t.boton)}
            aria-label="Contactar con MACI"
            class="px-8 py-4 bg-primary text-black font-bold uppercase tracking-widest text-sm hover:bg-white transition-all shadow-[0_0_15px_rgba(255,68,68,0.3)] hover:shadow-[0_0_25px_rgba(255,68,68,0.6)] rounded-full">{t.boton.es}</a>
        </div>
      </div>
    </div>
  </div>
</section>

---
// Colaboraciones: texto + tarjeta con borde LED animado.
import { SITE } from '../data/site';
---
<section id="colaboraciones" class="py-32 px-8 bg-background relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center">
    <div class="reveal mb-16">
      <div
        class="text-[0.6rem] md:text-[0.7rem] text-primary font-bold uppercase tracking-[0.2em] md:tracking-[0.5em] mb-4"
        data-i18n-es="UNIR FUERZAS" data-i18n-en="JOIN FORCES">
        UNIR FUERZAS</div>
      <h2 data-i18n-es="COLABORACIONES" data-i18n-en="COLLABORATIONS"
        class="reveal text-3xl md:text-6xl font-black uppercase tracking-tighter mb-8">COLABORACIONES</h2>
      <p data-i18n-es="La música está hecha para compartirse." data-i18n-en="Music is made to be shared."
        class="text-white/60 text-xl font-light italic">La música está hecha para compartirse.</p>
    </div>

    <div class="reveal space-y-8 text-on-surface-variant max-w-2xl mx-auto text-lg leading-relaxed mb-16">
      <p data-i18n-es="Si conectas con el universo de MACI y sientes que una canción también podría ser tuya, este espacio es para ti."
        data-i18n-en="If you connect with the MACI universe and feel that a song could be yours too, this space is for you.">
        Si conectas con el universo de MACI y sientes que una canción también podría ser tuya, este espacio es para
        ti.</p>
      <p data-i18n-es="Ya sea para interpretar un tema, crear una colaboración o dar vida a una nueva versión."
        data-i18n-en="Whether it's to perform a track, create a collaboration, or bring a new version to life.">
        Ya sea para interpretar un tema, crear una colaboración o dar vida a una nueva versión, las puertas están
        abiertas a artistas que vibren con la misma esencia.</p>
      <p data-i18n-es="Porque cada voz suma, cada historia transforma… y cada colaboración crea algo único."
        data-i18n-en="Because every voice adds up, every story transforms… and every collaboration creates something unique."
        class="font-bold text-white">Porque cada voz suma, cada historia transforma… y cada colaboración crea algo
        único.</p>
    </div>

    <div class="reveal relative overflow-hidden rounded-2xl p-[2px] mt-16 group">
      <!-- LED Moving Border (Rediseñado para evitar cortes del navegador por exceso de tamaño) -->
      <div
        class="absolute inset-[-200%] bg-[conic-gradient(transparent,transparent_35%,#FF4444_50%,transparent_50%,transparent_85%,#FF4444_100%)] animate-[spin_4s_linear_infinite]">
      </div>

      <!-- Inner Content masking the gradient -->
      <div
        class="relative bg-black/95 backdrop-blur-xl p-12 rounded-[14px] w-full h-full z-10 flex flex-col items-center border border-white/5">
        <h3 data-i18n-es="¿Tienes una idea?" data-i18n-en="Got an idea?"
          class="reveal text-2xl font-black uppercase tracking-tight mb-8 text-white">¿Tienes una idea?</h3>
        <div class="flex flex-wrap justify-center gap-6">
          <a href={SITE.instagram} target="_blank" rel="noopener noreferrer"
            data-i18n-es="CONTACTAME" data-i18n-en="CONTACT ME"
            aria-label="Contactar con MACI por Instagram"
            class="px-8 py-4 bg-primary text-black font-bold uppercase tracking-widest text-sm hover:bg-white transition-all shadow-[0_0_15px_rgba(255,68,68,0.3)] hover:shadow-[0_0_25px_rgba(255,68,68,0.6)] rounded-full">CONTACTAME</a>
        </div>
      </div>
    </div>
  </div>
</section>

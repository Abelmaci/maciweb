---
// Selector de idioma ES / EN (la lógica está en src/scripts/core.js).
---
<div
  class="fixed bottom-8 right-8 z-[200] flex items-center gap-4 bg-black/40 backdrop-blur-2xl border border-white/10 rounded-full py-2 px-5 shadow-2xl scale-90 md:scale-100 origin-right transition-all hover:border-primary/40">
  <span class="text-[0.65rem] font-bold tracking-[0.2em] transition-colors duration-300" id="label-es">ES</span>

  <div id="language-toggle"
    role="button"
    tabindex="0"
    aria-label="Cambiar idioma entre español e inglés"
    class="relative w-12 h-6 bg-white/10 rounded-full cursor-pointer p-1 transition-all hover:bg-white/20">
    <div id="toggle-circle"
      class="absolute left-1 w-4 h-4 bg-primary rounded-full transition-all duration-200 ease-out shadow-[0_0_10px_rgba(255,68,68,0.5)]">
    </div>
  </div>

  <span class="text-[0.65rem] font-bold tracking-[0.2em] text-white/40 transition-colors duration-300"
    id="label-en">EN</span>
</div>

---
// Barra de navegación fija + menú móvil a pantalla completa.
// El efecto de scroll y la apertura del menú están en src/scripts/.
import { TEXTOS } from '../data/textos';

// Menú editable en Strapi («0 · Ajustes generales» → Menú).
const NAV = TEXTOS.ajustes.menu.map((item) => ({ ...item, href: `#${item.destino}` }));
---
<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent py-6">
  <div class="max-w-[1440px] mx-auto px-6 flex justify-between items-center">
    <div class="flex items-center gap-4">
      <img src="/images/MaciLogo.svg" alt="Logotipo oficial de MACI, artista de música AI"
        width="1735" height="679"
        class="h-8 w-auto brightness-0 invert opacity-90 transition-all hover:opacity-100"
        referrerpolicy="no-referrer">
    </div>

    <!-- Mobile Menu Icon -->
    <button id="mobile-menu-btn" aria-label="Abrir menú de navegación" class="lg:hidden text-white z-50 relative">
      <svg class="text-white w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" stroke-width="2" stroke-linecap="round"/><line x1="3" y1="12" x2="21" y2="12" stroke-width="2" stroke-linecap="round"/><line x1="3" y1="18" x2="21" y2="18" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <div class="hidden lg:flex items-center gap-10">
      {NAV.map((item, i) => (
        <a href={item.href} data-i18n-es={item.es} data-i18n-en={item.en}
          class={`text-[0.875rem] font-bold tracking-[0.1em] uppercase transition-all duration-200 hover:text-primary ${i === 0 ? 'text-primary border-b-2 border-primary pb-1' : 'text-white/70'}`}>{item.es}</a>
      ))}
    </div>
  </div>
</nav>

<div id="mobile-menu"
  class="hidden fixed inset-0 z-[100] bg-black flex flex-col items-center justify-center gap-8 transition-all duration-500 ease-in-out opacity-0 translate-x-full">
  <button id="close-menu-btn" aria-label="Cerrar menú de navegación" class="absolute top-8 right-8 text-white z-[101]">
    <svg class="text-white w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="6" y1="6" x2="18" y2="18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  {NAV.map((item) => (
    <a href={item.href} data-i18n-es={item.es} data-i18n-en={item.en}
      class="text-2xl font-bold tracking-tighter transition-all duration-700 uppercase hover:text-primary">{item.es}</a>
  ))}
</div>

---
// "Lo que viene": texto + onda sonora animada (barras generadas en src/scripts/core.js).
// Los saltos de línea del texto (Strapi) se respetan con whitespace-pre-line.
import { TEXTOS, i18n } from '../data/textos';

const t = TEXTOS.loQueViene;
---
<section id="lanzamientos" class="py-16 md:py-32 px-8 bg-surface-container-low">
  <div class="max-w-4xl mx-auto">
    <div class="reveal text-center space-y-8 mb-20">
      <h2 {...i18n(t.titulo)}
        class="reveal text-6xl font-black uppercase tracking-tighter">{t.titulo.es}</h2>
      <p {...i18n(t.texto)}
        class="text-on-surface-variant text-lg leading-relaxed max-w-2xl mx-auto whitespace-pre-line">{t.texto.es}</p>
      <div class="text-primary opacity-50 text-2xl">⸻</div>
    </div>

    <div
      class="reveal bg-surface p-12 rounded-3xl border border-outline-variant/20 text-center space-y-6 relative overflow-hidden">
      <div class="absolute inset-0 bg-primary/5 pointer-events-none"></div>
      <div class="relative z-10 flex flex-col items-center">
        <div class="sound-wave mb-4" id="waveContainer"></div>
        <h3 {...i18n(t.tarjetaTitulo)}
          class="reveal text-2xl font-black uppercase tracking-tight">{t.tarjetaTitulo.es}</h3>
        <p {...i18n(t.tarjetaTexto)}
          class="text-white/70 max-w-lg mx-auto mt-4 whitespace-pre-line">{t.tarjetaTexto.es}</p>
      </div>
    </div>
  </div>
</section>

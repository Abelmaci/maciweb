---
// macimusic.es/crowdfunding/ — página de la campaña para compartir en redes.
// Su Open Graph (título, texto e imagen 1200×630) se edita en Strapi:
// «03 · Crowdfunding». La imagen la genera Strapi al exportar.
import BaseLayout from '../layouts/BaseLayout.astro';
import Crowdfunding from '../components/Crowdfunding.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { TEXTOS } from '../data/textos';

const c = TEXTOS.crowdfunding;
const url = 'https://macimusic.es/crowdfunding/';
---
{c.visible ? (
  <BaseLayout title={c.ogTitulo} description={c.ogDescripcion} url={url}
    ogImage="https://macimusic.es/images/og-crowdfunding.jpg" ogImageAlt={c.imagenAlt}>
    <nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent py-6">
      <div class="max-w-[1440px] mx-auto px-6 flex justify-between items-center">
        <a href="/" aria-label="Ir a la web de MACI">
          <img src="/images/MaciLogo.svg" alt="Logotipo oficial de MACI, artista de música AI" width="1735" height="679"
            class="h-8 w-auto brightness-0 invert opacity-90 transition-all hover:opacity-100">
        </a>
        <a href="/" class="text-[0.75rem] font-bold tracking-[0.1em] uppercase text-white/70 hover:text-primary transition-colors flex items-center gap-2">
          <span aria-hidden="true">←</span>
          <span data-i18n-es="VOLVER A LA WEB" data-i18n-en="BACK TO THE WEBSITE">VOLVER A LA WEB</span>
        </a>
      </div>
    </nav>

    <main>
      <Crowdfunding modo="pagina" />
    </main>
    <Footer />
    <LanguageSwitcher />

    <script>
      import '../scripts/main.js';
    </script>
  </BaseLayout>
) : (
  <html lang="es">
    <head>
      <meta charset="UTF-8">
      <meta name="robots" content="noindex">
      <meta http-equiv="refresh" content="0; url=/">
      <title>MACI</title>
    </head>
    <body><a href="/">macimusic.es</a></body>
  </html>
)}
